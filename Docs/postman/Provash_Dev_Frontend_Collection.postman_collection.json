{
  "info": {
    "_postman_id": "provash-dev-frontend-collection-v1",
    "name": "Provash Dev - Frontend Web Routes & Integration Collection",
    "description": "Postman collection to test Next.js 16 App Router web pages, SSR status 200, dynamic routes, HTML content responses, and frontend-to-backend API integrations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "frontendUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "backendUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Public Web Pages (SSR & Static)",
      "item": [
        {
          "name": "Homepage (Agency Landing & Hero)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html,application/xhtml+xml"
              }
            ],
            "url": {
              "raw": "{{frontendUrl}}/",
              "host": [
                "{{frontendUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is text/html', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
